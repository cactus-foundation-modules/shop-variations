{
  "name": "shop-variations",
  "version": "0.1.137",
  "tablePrefix": "svr_",
  "description": "Product options for the shop: variant matrices (size/colour) with per-variant price, stock, SKU and image, plus personalisation add-ons including file uploads.",
  "requiresCoreVersion": "0.5.1026",
  "requiresModules": [
    {
      "name": "shop",
      "minVersion": "0.1.222"
    }
  ],
  "permissions": [],
  "requiredEnvVars": [],
  "cookieCategories": [],
  "cronJobs": [
    {
      "path": "/api/m/shop-variations/cron/cleanup-uploads",
      "schedule": "0 3 * * *"
    }
  ],
  "extensionPoints": [
    {
      "point": "shop.products-tabs",
      "id": "variations",
      "label": "Variations",
      "order": 20,
      "permission": "shop.products",
      "import": "./components/admin/VariationsTab",
      "component": "VariationsTab"
    },
    {
      "point": "shop.product-editor-sections",
      "id": "variations-inline",
      "label": "Variations",
      "order": 50,
      "permission": "shop.products",
      "import": "./components/admin/ProductVariationsSection",
      "component": "ProductVariationsSection"
    },
    {
      "point": "shop.product-editor-media-sections",
      "id": "variations-gallery-order",
      "order": 10,
      "permission": "shop.products",
      "import": "./components/admin/ProductGalleryOrderSection",
      "component": "ProductGalleryOrderSection"
    },
    {
      "point": "shop.cart-line-resolver",
      "id": "variations-addons",
      "import": "./lib/line-resolver",
      "component": "resolveVariationLineMeta"
    },
    {
      "point": "shop.cart-line-resolver-prefetch",
      "id": "variations-addons",
      "import": "./lib/line-resolver",
      "component": "prefetchVariationLineMeta"
    },
    {
      "point": "shop.product-saved",
      "id": "variations-tax-class",
      "import": "./lib/tax-class-sync",
      "component": "syncVariationsOnProductSaved"
    },
    {
      "point": "shop.product-detail-parts",
      "id": "variations-detail-parts",
      "import": "./lib/detail-parts-provider",
      "component": "shopVariationsDetailParts"
    },
    {
      "point": "shop.product-page-resolver",
      "id": "variations-deep-link",
      "import": "./lib/product-page-resolver",
      "component": "shopVariationsProductPageResolver"
    },
    {
      "point": "shop.product-card-prices",
      "id": "variations-card-prices",
      "import": "./lib/card-price-provider",
      "component": "shopVariationsCardPrices"
    },
    {
      "point": "shop.product-search",
      "id": "variations-sku-search",
      "import": "./lib/product-search-provider",
      "component": "shopVariationsProductSearch"
    },
    {
      "point": "search.shop-product-text",
      "id": "variations-sku-text",
      "import": "./lib/search-text-provider",
      "component": "shopVariationsSearchText"
    },
    {
      "point": "shop.product-sales-rollup",
      "id": "variations-sales-rollup",
      "import": "./lib/sales-rollup-provider",
      "component": "shopVariationsSalesRollup"
    },
    {
      "point": "shop.product-availability",
      "id": "variations-availability",
      "import": "./lib/availability-provider",
      "component": "shopVariationsAvailability"
    },
    {
      "point": "shop.product-on-sale",
      "id": "variations-on-sale",
      "import": "./lib/sale-provider",
      "component": "shopVariationsOnSale"
    },
    {
      "point": "shop.card-media",
      "id": "variations-card-media",
      "import": "./lib/card-media-provider",
      "component": "shopVariationsCardMedia"
    },
    {
      "point": "shop.card-media",
      "id": "variations-card-options",
      "import": "./lib/card-options-provider",
      "component": "shopVariationsCardOptions"
    },
    {
      "point": "core.media-reference-rewriters",
      "id": "shop-variations",
      "import": "./lib/media-reference-rewriter",
      "component": "shopVariationsMediaReferenceRewriter"
    },
    {
      "point": "core.media-usage-providers",
      "id": "shop-variations",
      "import": "./lib/media-usage-provider",
      "component": "shopVariationsMediaUsageProvider"
    }
  ],
  "puckBlocks": [
    {
      "type": "ShopVariantPurchase",
      "import": "./components/puck/ShopVariantPurchase",
      "component": "shopVariantPurchasePuckComponent",
      "rscComponent": "shopVariantPurchasePuckRscComponent",
      "rscImport": "./components/puck/ShopVariantPurchase.rsc",
      "layoutTypes": [
        "shopProduct"
      ]
    },
    {
      "type": "ShopVariantOptions",
      "import": "./components/puck/variant-parts",
      "component": "shopVariantOptionsPuckComponent",
      "rscComponent": "shopVariantOptionsPuckRscComponent",
      "rscImport": "./components/puck/variant-parts.rsc",
      "layoutTypes": [
        "shopProductDetail"
      ]
    },
    {
      "type": "ShopVariantPersonalisation",
      "import": "./components/puck/variant-parts",
      "component": "shopVariantPersonalisationPuckComponent",
      "rscComponent": "shopVariantPersonalisationPuckRscComponent",
      "rscImport": "./components/puck/variant-parts.rsc",
      "layoutTypes": [
        "shopProductDetail"
      ]
    },
    {
      "type": "ShopVariantPrice",
      "import": "./components/puck/variant-parts",
      "component": "shopVariantPricePuckComponent",
      "rscComponent": "shopVariantPricePuckRscComponent",
      "rscImport": "./components/puck/variant-parts.rsc",
      "layoutTypes": [
        "shopProductDetail"
      ]
    },
    {
      "type": "ShopVariantAddToCart",
      "import": "./components/puck/variant-parts",
      "component": "shopVariantAddToCartPuckComponent",
      "rscComponent": "shopVariantAddToCartPuckRscComponent",
      "rscImport": "./components/puck/variant-parts.rsc",
      "layoutTypes": [
        "shopProductDetail"
      ]
    },
    {
      "type": "ShopCardVariationOptions",
      "import": "./components/puck/card-variation-options",
      "component": "shopCardVariationOptionsPuckComponent",
      "rscComponent": "shopCardVariationOptionsPuckRscComponent",
      "layoutTypes": [
        "shopProductCard"
      ]
    },
    {
      "type": "ShopVariantGallery",
      "import": "./components/puck/variant-parts",
      "component": "shopVariantGalleryPuckComponent",
      "rscComponent": "shopVariantGalleryPuckRscComponent",
      "rscImport": "./components/puck/variant-parts.rsc",
      "layoutTypes": [
        "shopProductDetail"
      ]
    }
  ],
  "memberExtensions": {
    "activityTypes": [],
    "notificationCategories": [],
    "dataExportPath": "/api/m/shop-variations/member/gdpr-export",
    "routeTiers": []
  },
  "teardown": [
    "svr_product_gallery",
    "svr_variant_values",
    "svr_variants",
    "svr_option_values",
    "svr_options",
    "svr_addons",
    "svr_uploads",
    "svr_settings"
  ]
}
